<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_pick_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:gravity="center"
        android:paddingBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHostMode"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingVertical="20dp"
        android:text="@string/mode_host"
        android:textSize="18sp"
        app:icon="@drawable/ic_desktop"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClientMode"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="20dp"
        android:text="@string/mode_client"
        android:textSize="18sp"
        app:icon="@drawable/ic_phone"
        app:iconGravity="textStart" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="40dp"
        android:text="主机模式需要 Root 权限；客户端模式免 Root 仅作局域网查找。"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:gravity="center" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
